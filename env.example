# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG chia sẻ file .env cho ai.
# Cách lấy từng giá trị xem trong HUONG-DAN.md

# Token của fanpage (Meta App Dashboard > Messenger > Access Tokens)
PAGE_ACCESS_TOKEN=

# App Secret (Meta App Dashboard > Settings > Basic > App Secret)
APP_SECRET=

# Chuỗi tự đặt (ví dụ: bmu-bot-2026), dùng khi cấu hình webhook — phải khớp 2 bên
VERIFY_TOKEN=

# Key AI (OpenAI hoặc dịch vụ tương thích OpenAI). Đăng ký tại https://platform.openai.com
AI_API_KEY=
# Nếu dùng dịch vụ AI khác tương thích OpenAI, đổi 2 dòng dưới cho phù hợp
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Thông tin để AI trả lời đúng về doanh nghiệp của bạn
BUSINESS_NAME=Tên fanpage / doanh nghiệp
BUSINESS_INFO=VD: Phòng khám đa khoa, mở cửa 7h-21h, địa chỉ 123 ABC, hotline 090xxxxxxx, dịch vụ khám tổng quát...

# Cổng chạy bot (mặc định 3000)
PORT=3000
