# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG chia sẻ file .env cho ai.
# Cách lấy từng giá trị xem trong HUONG-DAN.md

# Token của fanpage (Meta App Dashboard > Messenger > Access Tokens)
PAGE_ACCESS_TOKEN=

# App Secret (Meta App Dashboard > Settings > Basic > App Secret)
APP_SECRET=

# Chuỗi tự đặt (ví dụ: bmu-bot-2026), dùng khi cấu hình webhook — phải khớp 2 bên
VERIFY_TOKEN=

# Key AI. Có 3 lựa chọn (chỉ cần 1):
#  1) Muse của Meta (khuyên dùng): lấy key tại https://dev.meta.ai (mục API keys),
#     bản preview của Muse Spark đang miễn phí.
#     AI_BASE_URL=https://api.meta.ai/v1  và  AI_MODEL=muse-spark-1.3
#  2) Groq (miễn phí): https://console.groq.com
#     AI_BASE_URL=https://api.groq.com/openai/v1  và  AI_MODEL=llama-3.3-70b-versatile
#  3) OpenAI (trả phí): https://platform.openai.com
#     AI_BASE_URL=https://api.openai.com/v1  và  AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Điền BASE_URL và MODEL tương ứng với lựa chọn ở trên
AI_BASE_URL=https://api.meta.ai/v1
AI_MODEL=muse-spark-1.3

# Thông tin để AI trả lời đúng về doanh nghiệp của bạn
BUSINESS_NAME=Tên fanpage / doanh nghiệp
BUSINESS_INFO=VD: Phòng khám đa khoa, mở cửa 7h-21h, địa chỉ 123 ABC, hotline 090xxxxxxx, dịch vụ khám tổng quát...

# Cổng chạy bot (mặc định 3000)
PORT=3000
